{
  "name": "hackwriter",
  "version": "0.1.3",
  "description": "Writing agent for HackMD",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "main": "dist/cli.js",
  "bin": {
    "hackwriter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsgo",
    "dev": "node --experimental-transform-types src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm exec commit-and-tag-version && git push --follow-tags"
  },
  "keywords": [
    "hackmd",
    "ai",
    "agent",
    "cli",
    "markdown",
    "writing",
    "llm"
  ],
  "author": "Michael Wang <hi@eastsun.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/hackwriter.git"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@hackmd/api": "^2.7.0",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "knip": "^6.26.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
